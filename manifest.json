{
  "manifest_version": 3,
  "name": "Viewport Lab",
  "version": "1.0.0",
  "description": "Teste seu site em resoluções reais de iPhone, iPad, Galaxy Tab e notebooks, ou redimensione livremente.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Viewport Lab",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["declarativeNetRequestWithHostAccess", "storage"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["frame-bridge.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
